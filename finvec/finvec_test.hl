pp_print_newline std_formatter ();
pp_finvec_printer std_formatter `Vx[0;1]`;
pp_print_newline std_formatter ();
pp_finvec_printer std_formatter
   `Vx[0;3;9;12;0;3;3;1123;182883;9;12;0;3;
      9;88;12;9;12;0;3;9;12;0;3;9;88;12;0;3;9;12]`;
pp_print_newline std_formatter ();;

(* ------------------------------------------------------------------------- *)
(* Testing VECTOR_REDUCE_CONV.                                               *)
(* ------------------------------------------------------------------------- *)

VECTOR_REDUCE_CONV `Vx[a;b;c:A] $. 1`;;
VECTOR_REDUCE_CONV `Vx[a;b;c;d:A] $ 3`;;

VECTOR_RED_CONV `Vx[&1; &2 ; &3; &4; &5] = Vx[&3; -- &1; &1; &0; &4]`;;
VECTOR_RED_CONV `Vx[&1; &2 ; &3; &4; &5] + Vx[&3; -- &1; &1; &0; &4]`;;
VECTOR_RED_CONV `Vx[&1; &2 ; &3; &4; &5] - Vx[&3; -- &1; &1; &0; &4]`;;
VECTOR_RED_CONV `-- Vx[&1; &2 ; &3; &4; &5]`;;
VECTOR_RED_CONV `&3 % Vx[&1; &2 ; &3; &4; &5]`;;
VECTOR_RED_CONV `Vx[&1; &2 ; &3; &4; &5] dot Vx[&3; -- &1; &1; &0; &4]`;;

(TOP_SWEEP_CONV let_CONV THENC VECTOR_REDUCE_CONV THENC REAL_RAT_REDUCE_CONV)
  `let u = Vx[&1; -- &2; &1; &0; &3] in
   let v = Vx[&1; &2; &3; &4; &5] in
   (u dot v) / (u dot u) % u`;;

VECTOR_REDUCE_CONV
  `Vx[Vx[&1; &2]; Vx[&3; &4]] **
   Vx[Vx[-- &3; &2]; Vx[&2; &0]]`;;

prove
 (`Vx[Vx[&1; &2]; Vx[&3; &4]] ** Vx[Vx[-- &3; &2]; Vx[&2; &0]] =
   Vx[Vx[&1; &2]; Vx[-- &1; &6]]`,
  VECTOR_REDUCE_TAC);;

(TOP_SWEEP_CONV let_CONV THENC VECTOR_REDUCE_CONV)
`let A = Vx[Vx[&1; &2]; Vx[&3; &4]] in
 let B = Vx[Vx[-- &3; &2]; Vx[&2; &0]] in
 A ** B - B ** A`;;

prove
 (`let A = Vx[Vx[&1; &2]; Vx[&3; &4]] in
   let B = Vx[Vx[-- &3; &2]; Vx[&2; &0]] in
   A ** B - B ** A = Vx[Vx[-- &2; &0]; Vx[-- &3; &2]]`,
  CONV_TAC (TOP_SWEEP_CONV let_CONV) THEN
  VECTOR_REDUCE_TAC);;
