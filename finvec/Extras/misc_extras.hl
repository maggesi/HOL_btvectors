(* ------------------------------------------------------------------------- *)
(* Lemmata about the constructor `vector`.                                   *)
(* ------------------------------------------------------------------------- *)

let VECTOR_COMPONENT = prove
 (`!l i. 1 <= i /\ i <= dimindex(:B) ==> (vector l:A^B)$i = EL (i - 1) l`,
  REWRITE_TAC[vector] THEN ASM_SIMP_TAC[LAMBDA_BETA]);;

let VECTOR_INJ_EQ = prove
 (`!l1 l2.
     vector l1 = vector l2:A^N <=>
     (!i. 1 <= i /\ i <= dimindex(:N) ==> EL (i - 1) l1 = EL (i - 1) l2)`,
  REWRITE_TAC[CART_EQ] THEN SIMP_TAC[VECTOR_COMPONENT]);;

(* TODO: Delete, not needed. *)
let VECTOR_INJ = prove
 (`!l1 l2.
     vector l1 = vector l2:A^N
     ==> !i. 1 <= i /\ i <= dimindex(:N) ==> EL (i - 1) l1 = EL (i - 1) l2`,
  REWRITE_TAC[VECTOR_INJ_EQ]);;

(* ------------------------------------------------------------------------- *)
(* Quantifying on vector over fintypes.                                      *)
(* ------------------------------------------------------------------------- *)

(* TODO: Delete, not needed. *)
let VECTOR_CASES = prove
 (`!v:A^B. ?l. LENGTH l = dimindex(:B) /\ v = vector l`,
  GEN_TAC THEN EXISTS_TAC `list_of_seq (\i. (v:A^B)$(i+1)) (dimindex(:B))` THEN
  REWRITE_TAC[LENGTH_LIST_OF_SEQ; CART_EQ] THEN SIMP_TAC[VECTOR_COMPONENT] THEN
  REPEAT STRIP_TAC THEN IMP_REWRITE_TAC[EL_LIST_OF_SEQ] THEN
  CONJ_TAC THENL [AP_TERM_TAC; ALL_TAC] THEN ASM_ARITH_TAC);;

(* TODO: Delete, not needed. *)
let FORALL_VECTOR = prove
 (`!P. (!v:A^B. P v) <=> (!l. LENGTH l = dimindex(:B) ==> P (vector l))`,
  MESON_TAC[VECTOR_CASES]);;
