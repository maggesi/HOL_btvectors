(* ------------------------------------------------------------------------- *)
(* More about cardinality.                                                   *)
(* ------------------------------------------------------------------------- *)

let FINITE_OPTION = prove
 (`FINITE (:A option) <=> FINITE (:A)`,
  SUBGOAL_THEN `(:A option) = NONE INSERT IMAGE SOME (:A)` SUBST1_TAC THENL
  [SET_TAC[cases "option"];
   REWRITE_TAC[FINITE_INSERT] THEN
   SIMP_TAC[FINITE_IMAGE_INJ_EQ; injectivity "option"]]);;

let CARD_OPTION = prove
 (`FINITE (:A) ==> CARD (:A option) = CARD (:A) + 1`,
  SUBGOAL_THEN `(:A option) = NONE INSERT IMAGE SOME (:A)` SUBST1_TAC THENL
  [SET_TAC[cases "option"];
   SIMP_TAC[CARD_CLAUSES; FINITE_IMAGE] THEN
   REWRITE_TAC[IN_IMAGE; distinctness "option"] THEN
   SIMP_TAC[CARD_IMAGE_INJ; injectivity "option"] THEN ARITH_TAC]);;

let FINITE_SUM = prove
 (`FINITE(:A + B) <=> FINITE (:A) /\ FINITE (:B)`,
  SUBGOAL_THEN `(:A + B) = IMAGE INL (:A) UNION IMAGE INR (:B)`
    SUBST1_TAC THENL
  [SET_TAC[sum_CASES];
   REWRITE_TAC[FINITE_UNION] THEN
   SIMP_TAC[FINITE_IMAGE_INJ_EQ; sum_INJECTIVE]]);;

let CARD_SUM = prove
 (`FINITE (:A) /\ FINITE (:B) ==> CARD (:A + B) = CARD (:A) + CARD (:B)`,
  STRIP_TAC THEN
  SUBGOAL_THEN `(:A + B) = IMAGE INL (:A) UNION IMAGE INR (:B)`
    SUBST1_TAC THENL
  [SET_TAC[sum_CASES]; ALL_TAC] THEN
  SUBGOAL_THEN `IMAGE INL (:A) INTER IMAGE INR (:B) = {}`
    (fun th -> ASM_SIMP_TAC[th; CARD_UNION; FINITE_IMAGE]) THENL
  [SET_TAC[sum_DISTINCT]; ASM_SIMP_TAC[CARD_IMAGE_INJ; sum_INJECTIVE]]);;

