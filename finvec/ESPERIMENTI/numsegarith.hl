 (`(!n. (!i. i < NUMERAL n ==> P i) <=> (!i. i < n ==> P (NUMERAL i))) /\
   (!i. i < _0 ==> P i) /\
   (!n. (!i. i < BIT0 n ==> P i) <=>
        (!i. i < n ==> P (BIT0 i)) /\
        (!i. i < n ==> P (BIT1 i))) /\
   (!n. (!i. i < BIT1 n ==> P i) <=>
        P _0 /\
        (!i. i <= n ==> P (BIT0 i)) /\
        (!i. i <  n ==> P (BIT1 i)))`,
  CONV_TAC BITS_ELIM_CONV THEN REWRITE_TAC[FORALL_LT_BINARY]);;
*)

let FORALL_LE_ARITH = prove
 (`(!n. (!i. i <= NUMERAL n ==> P i) <=> (!i. i <= n ==> P (NUMERAL i))) /\
   ((!i. i <= _0 ==> P i) <=> P _0) /\
   (!n. (!i. i <= BIT0 n ==> P i) <=>
        (!i. i <= n ==> P (BIT0 i)) /\
        (!i. i <  n ==> P (BIT1 i))) /\
   (!n. (!i. i <= BIT1 n ==> P i) <=>
        P _0 /\
        (!i. i <= n ==> P (BIT0 i)) /\
        (!i. i <= n ==> P (BIT1 i)))`,
  CONV_TAC BITS_ELIM_CONV THEN REWRITE_TAC[FORALL_LE_BINARY]);;

