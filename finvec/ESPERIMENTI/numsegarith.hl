let BINARY_LT_THEN = prove
 (`(!n. 0 < n <=> (?p. n = 2 * p /\ 0 < p) \/
                  (?p. n = 2 * p + 1 /\ p < n)) /\
   (!m n. 2 * m < n <=> (m = 0 /\ 0 < n) \/
                        (?p. n = 2 * p /\ 0 < p /\ m < p) \/
                        (?p. n = 2 * p + 1 /\ m <= p)) /\
   (!m n. 2 * m + 1 < n <=> (?p. n = 2 * p /\ 0 < p /\ m < p) \/
                            (?p. n = 2 * p + 1 /\ m < p))`,
  REPEAT CONJ_TAC THEN TRY (FIX_TAC "m") THEN
  MATCH_MP_TAC FORALL_BINARY_THM THEN
  REWRITE_TAC[NUM_EQ_BINARY; NUM_LT_BINARY; UNWIND_THM1] THEN ARITH_TAC);;

let BINARY_LE_THEN = prove
 (`(!n. 0 <= n <=> n = 0 \/
                   (?p. n = 2 * p /\ 0 < p) \/
                   (?p. n = 2 * p + 1 /\ p <= n)) /\
   (!m n. 2 * m <= n <=> (m = 0 /\ 0 <= n) \/
                         (?p. n = 2 * p /\ 0 < p /\ m <= p) \/
                         (?p. n = 2 * p + 1 /\ m <= p)) /\
   (!m n. 2 * m + 1 <= n <=> (?p. n = 2 * p /\ 0 < p /\ m < p) \/
                             (?p. n = 2 * p + 1 /\ m <= p))`,
  REPEAT CONJ_TAC THEN TRY (FIX_TAC "m") THEN
  MATCH_MP_TAC FORALL_BINARY_THM THEN
  REWRITE_TAC[NUM_EQ_BINARY; NUM_LE_BINARY; UNWIND_THM1] THEN ARITH_TAC);;

let BINARY_GT_THAN = prove
 (`(!m. ~(m < 0)) /\
   (!m n. m < 2 * n <=> (m = 0 /\ 0 < n) \/
                        (?p. m = 2 * p /\ 0 < p /\ p < n) \/
                        (?p. m = 2 * p + 1 /\ p < n)) /\
   (!m n. m < 2 * n + 1 <=> m = 0 \/
                            (?p. m = 2 * p /\ 0 < p /\ p <= n) \/
                            (?p. m = 2 * p + 1 /\ p < n))`,
  REPEAT CONJ_TAC THEN MATCH_MP_TAC FORALL_BINARY_THM THEN
  REWRITE_TAC[NUM_EQ_BINARY; NUM_LT_BINARY; UNWIND_THM1] THEN ARITH_TAC);;

let BINARY_GE_THAN = prove
 (`(!m. m <= 0 <=> m = 0) /\
   (!m n. m <= 2 * n <=> (m = 0 /\ 0 <= n) \/
                         (?p. m = 2 * p /\ 0 < p /\ p <= n) \/
                         (?p. m = 2 * p + 1 /\ p < n)) /\
   (!m n. m <= 2 * n + 1<=> m = 0 \/
                            (?p. m = 2 * p /\ 0 < p /\ p <= n) \/
                            (?p. m = 2 * p + 1 /\ p <= n))`,
  REPEAT CONJ_TAC THEN MATCH_MP_TAC FORALL_BINARY_THM THEN
  REWRITE_TAC[NUM_EQ_BINARY; NUM_LE_BINARY; UNWIND_THM1] THEN ARITH_TAC);;

let BINARY_EQ = REWRITE_RULE [] (CONV_RULE BITS_ELIM_CONV ARITH_EQ);;
let BINARY_LT = REWRITE_RULE [] (CONV_RULE BITS_ELIM_CONV ARITH_LT);;
let BINARY_LE = REWRITE_RULE [] (CONV_RULE BITS_ELIM_CONV ARITH_LE);;

let FORALL_BINARY_CASES = prove
 (`(!n. P n) <=>
   P 0 /\
   (!n. 0 < n ==> P (2 * n)) /\
   (!n. P (2 * n + 1))`,
  EQ_TAC THENL [SIMP_TAC[]; ALL_TAC] THEN STRIP_TAC THEN GEN_TAC THEN
  STRUCT_CASES_TAC (SPEC `n:num` NUM_BINARY_CASES_STRONG) THEN ASM_SIMP_TAC[]);;

