let FORALL_LT_BINARY = prove
 (`(!i. i < 0 ==> P i) /\
   (!n. (!i. i < 2 * n ==> P i) <=>
        (!i. i < n ==> P (2 * i)) /\
        (!i. i < n ==> P (2 * i + 1))) /\
   (!n. (!i. i < 2 * n + 1 ==> P i) <=>
        P 0 /\
        (!i. i <= n ==> P (2 * i)) /\
        (!i. i < n ==> P (2 * i + 1)))`,
   REWRITE_TAC[BINARY_GT_THAN] THEN CONJ_TAC THEN GEN_TAC THEN
   (EQ_TAC THENL
     [DISCH_TAC THEN REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC[BINARY_EQ; UNWIND_THM1] THEN ASM_ARITH_TAC
      ;
      REPEAT STRIP_TAC THEN REPEAT (FIRST_X_ASSUM SUBST_VAR_TAC) THEN
      ASM_SIMP_TAC[]]) THEN
   ASM_MESON_TAC[ARITH_RULE `0 = 2 * 0`]);;

let FORALL_LE_BINARY = prove
 (`((!i. i <= 0 ==> P i) <=> P 0) /\
   (!n. (!i. i <= 2 * n ==> P i) <=>
        (!i. i <= n ==> P (2 * i)) /\
        (!i. i <  n ==> P (2 * i + 1))) /\
   (!n. (!i. i <= 2 * n + 1 ==> P i) <=>
        P 0 /\
        (!i. i <= n ==> P (2 * i)) /\
        (!i. i <= n ==> P (2 * i + 1)))`,
   REWRITE_TAC[BINARY_GE_THAN] THEN
   CONJ_TAC THENL [MESON_TAC[]; ALL_TAC] THEN
   CONJ_TAC THEN GEN_TAC THEN
   (EQ_TAC THENL
     [DISCH_TAC THEN REPEAT STRIP_TAC THEN FIRST_X_ASSUM MATCH_MP_TAC THEN
      REWRITE_TAC[BINARY_EQ; UNWIND_THM1] THEN
      ASM_ARITH_TAC
      ;
      REPEAT STRIP_TAC THEN REPEAT (FIRST_X_ASSUM SUBST_VAR_TAC) THEN
      ASM_SIMP_TAC[]]) THEN
   ASM_MESON_TAC[ARITH_RULE `0 = 2 * 0`]);;

