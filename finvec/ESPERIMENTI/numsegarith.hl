let FORALL_LT_ARITH = prove
 (`(!n. (!i. i < NUMERAL n ==> P i) <=> (!i. i < n ==> P (NUMERAL i))) /\
   (!i. i < _0 ==> P i) /\
   (!n. (!i. i < BIT0 n ==> P i) <=>
        (!i. i < n ==> P (BIT0 i)) /\
        (!i. i < n ==> P (BIT1 i))) /\
   (!n. (!i. i < BIT1 n ==> P i) <=>
        P _0 /\
        (!i. i < n ==> P (BIT0 (SUC i))) /\
        (!i. i <  n ==> P (BIT1 i)))`,
  CONV_TAC BITS_ELIM_CONV THEN REWRITE_TAC[FORALL_LT_BINARY] THEN
  GEN_TAC THEN EQ_TAC THEN STRIP_TAC THEN ASM_REWRITE_TAC[] THENL
  [ASM_MESON_TAC[ARITH_RULE `i < n ==> SUC i <= n`]; ALL_TAC] THEN
  GEN_TAC THEN DISCH_TAC THEN ASM_CASES_TAC `i = 0` THEN
  ASM_REWRITE_TAC[NUM_MULT_CONV `2 * 0`] THEN
  ASM_METIS_TAC[ARITH_RULE `~(i = 0) /\ i <= n ==> i = SUC (i - 1) /\ i - 1 < n`]);;

REWRITE_CONV[FORALL_LT_ARITH; FORALL_LE_ARITH; ARITH_SUC; GSYM CONJ_ASSOC]
`!i. i < 50 ==> P i`;;
