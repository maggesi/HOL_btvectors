(* ========================================================================= *)
(* Finlambda.                                                                *)
(* ========================================================================= *)

(*
let transp0 = prove
 (`!A:real^M^N. transp A = lambda0 i j. A$.j$.i`,

  REWRITE_TAC[CART_EQ0]
  SIMP_TAC[LAMBDA0_BETA] THEN
*)

let LAMBDA0_ARITH_NUMERAL, LAMBDA0_ARITH_CLAUSES = CONJ_PAIR LAMBDA0_ARITH;;

(REWRITE_CONV[transp; LAMBDA_EQ_LAMBDA0] THENC
 GEN_REWRITE_CONV I [LAMBDA0_ARITH_NUMERAL] THENC
 ONCE_DEPTH_CONV BETA_CONV THENC
 GEN_REWRITE_CONV BINDER_CONV [LAMBDA0_ARITH_NUMERAL] THENC
 ONCE_DEPTH_CONV BETA_CONV THENC
 SIMP_CONV[INDEX_EQ_COMPONENT0; ARITH_RULE `!i. 1 <= i + 1`] THENC
 REWRITE_CONV[ARITH_RULE `(i+1)-1 = i`] THENC
 REWRITE_CONV[LAMBDA0_ARITH_CLAUSES; ARITH_ZERO] THENC
 REDEPTH_CONV VECTOR_COMPONENT0_CONV THENC
 ALL_CONV)
 `transp(Vx[Vx[x; a]; Vx[v; r]])`;;

let matrix_mul0 = prove
 (`!A:real^N^M B:real^P^N.
     A ** B = lambda0 i j. sum (0..dimindex(:N)-1) (\k. A$.i$.k * B$.k$.j)`,
  REPEAT GEN_TAC THEN
  REWRITE_TAC[matrix_mul; LAMBDA_EQ_LAMBDA0; CART_EQ0] THEN
  SIMP_TAC[LAMBDA0_BETA] THEN REPEAT STRIP_TAC THEN
  ONCE_SIMP_TAC[SUM_OFFSET_0; DIMINDEX_GE_1; LE_0] THEN
  REWRITE_TAC[ARITH_RULE `!n. n - 0 = n /\ n + 0 = n`; component0]);;

(REWRITE_CONV[matrix_mul0] THENC
 ONCE_DEPTH_CONV DIMINDEX_CONV THENC
 NUM_REDUCE_CONV THENC
 ONCE_DEPTH_CONV NUMSEG_CONV THENC
 SIMP_CONV[SUM_CLAUSES; FINITE_INSERT; FINITE_EMPTY] THENC
 REWRITE_CONV[IN_INSERT; NOT_IN_EMPTY; ARITH_EQ; REAL_ADD_RID] THENC
 GEN_REWRITE_CONV I [LAMBDA0_ARITH_NUMERAL] THENC
 ONCE_DEPTH_CONV BETA_CONV THENC
 GEN_REWRITE_CONV BINDER_CONV [LAMBDA0_ARITH_NUMERAL] THENC
 ONCE_DEPTH_CONV BETA_CONV THENC
 REWRITE_CONV[LAMBDA0_ARITH_CLAUSES; ARITH_ZERO] THENC
 REDEPTH_CONV VECTOR_COMPONENT0_CONV THENC
 REAL_RAT_REDUCE_CONV THENC
 ALL_CONV)
`Vx[Vx[&3; &2; &0];
    Vx[&1; &1; &12]]
 **
 Vx[Vx[&0; &9];
    Vx[&1; &0];
    Vx[&0; &10]]`;;

MATRIX_MUL_ARITH;;

GEN_REWRITE_CONV REDEPTH_CONV
  [MATRIX_MUL_ARITH; VECTOR_MATRIX_MUL_ARITH; MATRIX_VECTOR_MUL_ARITH]
`Vx[Vx[&3; &2; &0];
    Vx[&1; &1; &12]]
 **
 Vx[Vx[&0; &9];
    Vx[&1; &0];
    Vx[&0; &10]]`;;
