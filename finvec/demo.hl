(* ========================================================================= *)
(* Demonstration of use of VECTOR_REDUCE_CONV.                               *)
(*                                                                           *)
(* (c) Copyright, Andrea Gabrielli, Marco Maggesi 2017-2018                  *)
(* ========================================================================= *)

(* ------------------------------------------------------------------------- *)
(* Type inference for vectors.                                               *)
(* ------------------------------------------------------------------------- *)

type_of `Vx[a:A;b;c;d;e;f;g;h;i;j;k;l;m;n;_o;p;q;r;s;t;u;v;w;z]`;;

(* ------------------------------------------------------------------------- *)
(* Computing the component of a vector.                                      *)
(* ------------------------------------------------------------------------- *)

VECTOR_REDUCE_CONV
  `Vx[a:A;b;c;d;e;f;g;h;i;j;k;l;m;n;_o;p;q;r;s;t;u;v;w;z] $ 13`;;

(* ------------------------------------------------------------------------- *)
(* Orthogonal projection of a vector.                                        *)
(* ------------------------------------------------------------------------- *)

(let_CONV THENC let_CONV THENC VECTOR_REDUCE_CONV)
  `let u = Vx[&1; -- &2; &1; &0; &3] in
   let v = Vx[&1; &2; &3; &4; &5] in
   (u dot v) / (u dot u) % u`;;

(* ------------------------------------------------------------------------- *)
(* Commutator of two matrices.                                               *)
(* ------------------------------------------------------------------------- *)

(let_CONV THENC let_CONV THENC VECTOR_REDUCE_CONV)
`let A = Vx[Vx[&1; &2; &3; &4; &5];
            Vx[&6; &7; &8; &9; &0];
            Vx[&1; &2; &3; &4; &5]; 
            Vx[&6; &7; &8; &9; &0];
            Vx[&1; &2; &3; &4; &5]] in
 let B = Vx[Vx[&0; -- &3; &2; -- &5; &1];
            Vx[-- &2; &2; &0; &0; &10];
            Vx[&0; -- &2; &5; &1; &00];
            Vx[&3; &7; &1; &13; &0];
            Vx[&3; &0; &1; &1; &7]] in
 A ** B - B ** A`;;
